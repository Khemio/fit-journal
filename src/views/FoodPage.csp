<%inc
#include "../dto/food.h"
%>

<%c++ 
    auto entry_id = @@.get<unsigned long>("entry_id");
%>

<div>
  
<form hx-get="/foods/search"
      hx-trigger="keyup changed delay:500ms, search, submit, foodAdded"
      hx-target="#food-items"
      hx-swap="outerHTML"
      id="food-search"
      >
    <input class="form-control" type="search"
      name="food_name" placeholder="Begin typing to search foods..."
    >
</form>

  <%c++ if (entry_id == 0) { %>
    <button data-target="new-food-modal" hx-on:click="toggleModal(event)">+</button>    
  <%c++ } %>
</div>

<table id="food-table">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Quantity</th>
      <th scope="col">Protein</th>
      <th scope="col">Calories</th>
    </tr>
  </thead>

  <%view FoodList %>

</table>

<%c++ if (entry_id == 0) { %>
  <dialog id="new-food-modal">
    <article>
      <header>
          <button aria-label="Close" 
              rel="prev"
              data-target="new-food-modal"
              hx-on:click="toggleModal(event)"
          ></button>
          <p>
              <strong>Fill in the form with parameters of the new food</strong>
          </p>
      </header>
      <p>
        <form id="new-food-form" hx-post="/foods/add" hx-trigger="submit">
          <div>
            <label for="food-name">Food Name</label>
            <input type="text" id="food-name" name="food-name"
              >
          </div>

          <div>
            <label for="quantity">Quantity</label>
            <input type="number" id="quantity" name="quantity" min="0"
              value="0"
              step="0.01"
              >
          </div>

          <div>
            <label for="quantity-type">Quantity Type</label>
            <input type="text" id="quantity-type" name="quantity-type"
              >
          </div>

          <div>
            <label for="protein">Protein per Quantity</label>
            <input type="number" id="protein" name="protein"
              min="0"
              step="0.01"
              >
          </div>

          <div>
            <label for="calories">Calories per Quantity</label>
            <input type="number" id="calories" name="calories"
              min="0"
              step="0.1"
              >
          </div>          
            
        </form> 
      </p>
      <footer>
        <button 
            data-target="new-food-modal"
            hx-on:click="toggleModal(event)"
            role="button"
            class="secondary">
            Cancel
        </button>
        <button data-target="new-food-modal" 
            style="max-width: max-content"
            form="new-food-form"
            type="submit"
            hx-on:click="toggleModal(event)">
            Add
        </button>
      </footer>
    </article>
  </dialog>
<%c++ } %>
